{
  "name": "@cordishub/cli",
  "version": "0.11.0",
  "description": "CordisHub terminal companion — search plugins, watch cost, replay sessions.",
  "type": "module",
  "main": "./src/index.ts",
  "bin": {
    "cordishub": "./src/index.ts"
  },
  "scripts": {
