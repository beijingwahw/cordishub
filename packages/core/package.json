{
  "name": "@cordishub/core",
  "version": "0.11.0",
  "description": "CordisHub core — the meta-plugin that turns DeepSeek Harness into a workstation: plugin hub, replay lab, cost console, safety net.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./replay": "./src/replay.ts",
    "./cost": "./src/cost.ts",
    "./hub": "./src/hub.ts",
    "./safety": "./src/safety.ts"
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "node --test \"test/*.test.ts\"",
    "demo": "node --experimental-strip-types demo/run.ts"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "cordis",
    "agent",
    "harness",
    "plugin",
    "replay",
    "cost",
    "observability"
  ],
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": { "optional": true },
    "cordis": { "optional": true }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "*",
    "cordis": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
