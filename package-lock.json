{
  "name": "cordishub",
  "version": "0.6.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "cordishub",
      "version": "0.6.0",
      "license": "MIT",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=22.6.0"
      }
    },
    "node_modules/@cordishub/cli": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@cordishub/core": {
      "resolved": "packages/core",
      "link": true
    },
    "packages/cli": {
      "name": "@cordishub/cli",
      "version": "0.6.0",
      "dependencies": {
        "@cordishub/core": "file:../core"
      },
      "bin": {
        "cordishub": "src/index.ts"
      },
      "engines": {
        "node": ">=22.6.0"
      }
    },
    "packages/core": {
      "name": "@cordishub/core",
      "version": "0.6.0",
      "license": "MIT",
      "devDependencies": {
        "@types/node": "^22.10.0",
        "typescript": "^5.7.0"
      },
      "peerDependencies": {
        "@deepseek-ai/dsh": "*",
        "cordis": "*"
      },
      "peerDependenciesMeta": {
        "@deepseek-ai/dsh": {
          "optional": true
        },
        "cordis": {
          "optional": true
        }
      }
    },
    "packages/core/node_modules/@types/node": {
      "version": "22.20.5",
      "dev": true,
      "license": "MIT",
      "dependencies": {
        "undici-types": "~6.21.0"
      }
    },
    "packages/core/node_modules/typescript": {
      "version": "5.9.3",
      "dev": true,
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "packages/core/node_modules/undici-types": {
      "version": "6.21.0",
      "dev": true,
      "license": "MIT"
    }
  }
}
